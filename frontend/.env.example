# API Configuration
VITE_API_URL=http://localhost:8000/api
VITE_API_TIMEOUT=30000

# Authentication: preview stores test account profiles locally; switch to api when backend is ready
VITE_AUTH_MODE=preview

# App Configuration
VITE_APP_NAME=Campus E-Commerce
VITE_APP_VERSION=1.0.0

# Feature Flags
VITE_ENABLE_CHAT=true
VITE_ENABLE_REVIEWS=true
